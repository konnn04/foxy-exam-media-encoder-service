# Media Encoder Service
API_KEY=K..,.
PORT=8097

# Docker: see docker-compose.yml — storage is mounted at /var/www/html/storage/app/private (same as Laravel in Docker).

# auto = probe NVENC then QSV, else libx264 (veryfast). Alpine + no GPU devices → CPU.
# NVIDIA: --gpus all + FFmpeg build with nvenc, then MEDIA_ENCODER_VIDEO=nvenc
# Intel QSV: devices /dev/dri, then MEDIA_ENCODER_VIDEO=qsv
MEDIA_ENCODER_VIDEO=auto

# When using CPU: ultrafast | veryfast | fast | medium
MEDIA_ENCODER_CPU_PRESET=veryfast
